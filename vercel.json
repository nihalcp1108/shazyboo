{
  "buildCommand": "npm run build --prefix client",
  "installCommand": "npm install --prefix client --legacy-peer-deps",
  "framework": "vite",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.mjs"
    }
  ]
}

