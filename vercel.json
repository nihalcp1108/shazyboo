{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://shazyboo.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://shazyboo.onrender.com/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "client/dist"
}
